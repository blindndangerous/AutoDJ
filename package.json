{
  "name": "autodj-frontend",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "description": "Development tooling for the AutoDJ web UI: vitest unit tests, ESLint, knip and the Playwright audits.  The server serves src/autodj/static as-is; nothing here is needed to run AutoDJ.",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint --max-warnings 0 src/autodj/static tests/jsmodules tests/playwright vitest.config.js eslint.config.js",
    "deadcode": "knip",
    "audit:transitions": "node tests/playwright/transition_audit.mjs",
    "audit:health": "node tests/playwright/health_audit.mjs",
    "audit:sso": "node tests/playwright/sso_audit.mjs",
    "audit:visual": "node tests/playwright/visual_audit.mjs",
    "audit:reviews": "node tests/playwright/programme_review_audit.mjs",
    "audit:editions": "node tests/playwright/prepared_edition_audit.mjs",
    "audit:settings": "node tests/playwright/settings_audit.mjs",
    "audit:ci": "npm run audit:health && npm run audit:transitions && npm run audit:visual && npm run audit:settings"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "axe-core": "^4.14.0",
    "eslint": "^10.13.0",
    "happy-dom": "^21.0.4",
    "knip": "^6.43.0",
    "vitest": "^5.0.5"
  },
  "knip": {
    "entry": [
      "commitlint.config.cjs",
      "src/autodj/static/app.js",
      "src/autodj/static/*-worklet.js",
      "src/autodj/static/modules/theme-init.js",
      "tests/jsmodules/**/*.test.js",
      "tests/playwright/*.mjs"
    ]
  },
  "engines": {
    "node": ">=26"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
