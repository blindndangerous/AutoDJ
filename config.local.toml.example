# Per-machine overrides, loaded only when a sibling base configuration file is loaded.
# Copy to config.local.toml; this example remains safe to commit.
# Only sections and keys from config.toml.example are accepted; any other is an error.

[library]
music_dir = "/srv/music"
beets_db = "/srv/beets/library.db"

[index]
# Each named index directory may contain vectors.index, tracks.db (SQLite),
# dj_meta.db (SQLite), web_state.json, and liner files.
# Default liner path: <index_dir>/<name>/liners/.
index_dir = "/srv/autodj/index"
model_dir = "/srv/autodj/models"

[server]
host = "127.0.0.1"
port = 8080
# Supply access_token through AUTODJ_ACCESS_TOKEN; never commit it here.
# HTTPS for your own domain on the LAN and through a Cloudflare Tunnel with Cloudflare
# Access (see "HTTPS with your own domain" in docs/operations.md).  The same as
# `autodj serve --lan --allowed-host autodj.example.net
# --allowed-origin https://autodj.example.net --ssl-certfile ... --ssl-keyfile ...`:
# lan = true
# allowed_hosts = ["autodj.example.net"]
# allowed_origins = ["https://autodj.example.net"]
# ssl_certfile = "/srv/autodj/tls/fullchain.pem"
# ssl_keyfile = "/srv/autodj/tls/privkey.pem"
