# Per-machine overrides. Copy to config.local.toml; this example is safe to commit.
# These values are loaded when a sibling base configuration file is loaded.
# The index contains library.db and dj_meta.db plus stations/<slug>/ state.
# Station secrets do not belong in TOML. AutoDJ stores default station relay
# passwords in <index_dir>/stations/default/relays.json and listener credentials
# and webhooks in that folder's secrets.json. Other stations have matching files
# under their own slug. These files are private and excluded from backups.

[library]
# beets_db = "/srv/beets/library.db"

[index]
# Keep a separate catalog per machine and register folders using that machine's paths.
index_dir = "/srv/autodj/index"
model_dir = "/srv/autodj/models"

[server]
host = "127.0.0.1"
port = 8080
# access_token = "private-pairing-secret"
# lan = true
# allowed_hosts = ["autodj.example.net"]
# allowed_origins = ["https://autodj.example.net"]
# ssl_certfile = "/srv/autodj/tls/fullchain.pem"
# ssl_keyfile = "/srv/autodj/tls/privkey.pem"
# trusted_proxies = ["127.0.0.1", "192.168.1.10"]
# live_plain_http_lan = false
