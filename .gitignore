# Local isolated workspaces
.worktrees/

# Personal config (contains local paths) — use config.toml.example as the template
config.toml
# Per-machine overlay applied on top of config.toml (paths such as
# music_dir and beets_db differ between hosts). Never shared between machines.
# The .example variants ARE committed (templates); the deployed copies
# (with real paths) are not.
config.local.toml
config.local.toml.linux
config.local.toml.windows
# Doctor backups contain the same machine-specific paths and secrets.
*.toml.doctor-*.bak
.env

# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
.uv/
dist/
*.egg-info/

# AutoDJ generated files
index/
models/

# Editor
.vscode/
.idea/
*.swp

# Test temp files
tmp/

# Runtime web-UI snapshots (saved by the browser via "View page source")
served.html

# Tool caches
.mypy_cache/
.ruff_cache/
.pytest_cache/

# Coverage (scripts/ci_pytest.py writes the json + xml into the repo root)
.coverage
coverage.json
coverage.xml
htmlcov/

# OS
.DS_Store
Thumbs.db

# Node dependencies (resolved versions live in committed package-lock.json)
node_modules/
# Audit reports may contain LAN paths / track metadata
*_audit.json
*_audit_report.json
.playwright-mcp/

# TLS certificate and private key for [server] ssl_certfile / ssl_keyfile
certs/
*.pem
