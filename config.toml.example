# AutoDJ shared configuration
# Copy this file to config.toml. Per-machine paths and private server settings
# can go in the gitignored config.local.toml.
#
# Every station, including default, is configured in
# <index_dir>/stations/<slug>/station.json. Station output, stream, playback,
# recording, timezone and upload limits are station-specific. Listener/relay
# passwords and webhooks are in that station folder's secrets.json/relays.json.
# On startup AutoDJ migrates legacy root station sections and [stations.<slug>]
# TOML tables into those files once; normal config loading does not fall back to
# those TOML settings. See docs/operations.md, Several stations.
#
# Shared environment overrides:
# BEGIN ENVIRONMENT OVERRIDES
#   AUTODJ_LIBRARY_MUSIC_DIR
#   AUTODJ_INDEX_DIR
#   AUTODJ_MODEL_DIR
#   AUTODJ_HOST
#   AUTODJ_PORT
#   AUTODJ_ACCESS_TOKEN
#   AUTODJ_LAN
#   AUTODJ_HUGGINGFACE_TOKEN
# END ENVIRONMENT OVERRIDES
#
# Station stream overrides use AUTODJ_STATION_<SLUG>_STREAM_<SETTING>, such as
# AUTODJ_STATION_DEFAULT_STREAM_BITRATE. Legacy AUTODJ_STREAM_* values are
# migration input only; AUTODJ_STREAM_RELAY_* passwords are migrated once to
# default/relays.json when the matching relay exists.

[library]
# Full path to a beets SQLite library database (optional).
# beets_db = "C:/Users/you/.config/beets/library.db"
supported_formats = ["mp3", "flac", "m4a"]
# playlists_folder = "/srv/autodj/playlists"

[index]
# Contains shared library data (library.db and dj_meta.db) and per-station state.
# Keep a separate catalog per machine and register folders using that machine's paths.
index_dir = "index"
model_dir = "models"
throttle_ms = 0

[server]
host = "127.0.0.1"
port = 8080
# access_token = "generate-at-least-32-random-bytes"
lan = false
insecure_lan = false
session_ttl_seconds = 7776000
# Only direct proxy peers listed here may supply forwarded client addresses.
# trusted_proxies = ["192.168.1.10"]
# Shared policy for whether live DJ logins may use plain HTTP from the LAN.
live_plain_http_lan = false
# HTTPS certificate and key; both or neither. CLI options can override these.
# ssl_certfile = "/srv/autodj/tls/fullchain.pem"
# ssl_keyfile = "/srv/autodj/tls/privkey.pem"

[model]
# Model download/cache settings are shared by all stations.

[huggingface]
# token = "private-token"
