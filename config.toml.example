# AutoDJ Configuration
# Copy this file to config.toml and adjust paths to match your setup.
#
# ---------------------------------------------------------------------------
# Per-machine overlay (config.local.toml)
# ---------------------------------------------------------------------------
# If a sibling file `config.local.toml` exists, its keys are deep-merged on
# top of this file at load time. Use it for per-machine paths while keeping
# deployment-wide settings in the private base config. Both files are
# gitignored:
#
#   config.toml          = private deployment/base settings
#   config.local.toml    = private per-machine overrides
#
# Example config.local.toml on a Windows host pointing at beets:
#
#   [library]
#   beets_db = "Z:/Music/.config/beets/library.db"
#
# Configuration precedence:
# defaults < config.toml < config.local.toml < environment
#   < settings saved from the web page (web_state.json, serve only) < CLI
#
# Configuration keys are validated when loaded. An unknown section or key is
# ignored with a warning that names it, and the setting keeps its default, so a
# misspelled key changes nothing: correct or delete the line.
#
# Supported environment overrides:
# BEGIN ENVIRONMENT OVERRIDES
#   AUTODJ_LIBRARY_MUSIC_DIR
#   AUTODJ_INDEX_DIR
#   AUTODJ_MODEL_DIR
#   AUTODJ_HOST
#   AUTODJ_PORT
#   AUTODJ_ACCESS_TOKEN
#   AUTODJ_LAN
#   AUTODJ_HUGGINGFACE_TOKEN
#   AUTODJ_STREAM_ENABLED
#   AUTODJ_STREAM_CONTINUOUS
#   AUTODJ_STREAM_BITRATE
#   AUTODJ_STREAM_IDLE_GRACE_SECONDS
#   AUTODJ_STREAM_MAX_LISTENERS
#   AUTODJ_STREAM_STATION_NAME
# END ENVIRONMENT OVERRIDES

[library]
# Full path to your beets SQLite library database (optional).
# Find it by running: beet config | grep library
# Leave blank to skip beets integration and use filesystem scanning instead.
beets_db = "C:/Users/you/.config/beets/library.db"

# Audio formats to scan for
supported_formats = ["mp3", "flac", "m4a"]

# Folder of M3U and M3U8 files that rotation categories (Library tools,
# Categories) read, such as rotation playlists an update script writes.
# Default: <index_dir>/<name>/playlists.  The files are not backed up.
# playlists_folder = "/srv/autodj/playlists"

[index]
# Each named library directory <index_dir>/<name>/ holds library.db, dj_meta.db,
# station state, and liner files. Default liner path: <index_dir>/<name>/liners/.
# Keep a separate catalog per machine and register folders using that machine's paths.
# Do not share this directory between an indexing machine and a playout machine.
index_dir = "index"

# Directory where the MuQ model checkpoint is cached after download
model_dir = "models"

# The named index to use, kept in <index_dir>/<name>/.  `--name` on index,
# prune, enrich, analyse, serve and stats replaces it for that command.
# name = "default"

# Pause before each track that `autodj index` embeds and that `autodj index` and
# `autodj analyse` analyse, in milliseconds, to give network drives a rest on
# long runs.  0 = no pause.
throttle_ms = 0

[server]
# Time zone for scheduled events (Settings, Schedule), as an IANA name.
# Omit to use the system time zone (UTC when the system has no IANA name).
# A time zone saved in Settings, Stations takes the place of this one.
# station_timezone = "America/Denver"
host = "127.0.0.1"
port = 8080
# access_token = "generate-at-least-32-random-bytes"  # Internal pairing/session secret.
# Serve on your local network (same as `autodj serve --lan`): listen on all
# interfaces, allow this machine's detected names and addresses, and require
# pairing.  Without access_token, a token is created in index_dir/.access-token.
lan = false
insecure_lan = false
# lan = true fills both lists with this machine's names and addresses, and a
# single-address host allows itself.  A wildcard host (0.0.0.0 or ::) without
# lan = true must set both lists, for example:
# allowed_hosts = ["radio.local"]
# allowed_origins = ["https://radio.local:8080"]
session_ttl_seconds = 7776000  # 90 days; revoke paired browsers with `autodj devices`.
# Largest voice liner or cart clip upload, in MiB.
liner_upload_max_mib = 50
# Serve HTTPS: a PEM certificate chain and its private key, both or neither.  Both files
# must exist at startup; --ssl-certfile and --ssl-keyfile replace them.  Renewed files are
# picked up within five minutes without a restart.  See "HTTPS with your own domain" in
# docs/operations.md for a Let's Encrypt certificate and remote access.
# ssl_certfile = "/srv/autodj/tls/fullchain.pem"
# ssl_keyfile = "/srv/autodj/tls/privkey.pem"
# Live DJs (stream mode): BUTT or Mixxx log in to the station's source mount with a DJ
# password.  Over plain HTTP that is accepted only from this machine unless this is true,
# which also accepts it from the local network, the password then crossing the LAN
# unencrypted.  HTTPS needs nothing here.  See "Live DJs and talkover" in docs/operations.md.
live_plain_http_lan = false

# ---------------------------------------------------------------------------
# Radio-style MP3 stream — server mixes the set and serves it as a live
# MP3 feed, so any player (car head unit, another room's speaker) can tune
# in as a remote, not just a browser tab.  Off by default.  Stream mode is
# chosen at start-up (`autodj serve --stream` / `--no-stream` override
# `enabled` below); it cannot be switched while the server runs.  Requires
# ffmpeg on the PATH (checked by `autodj doctor` and refused at startup).
# ---------------------------------------------------------------------------
[stream]
enabled = false

# Keep the station playing when nobody is connected. When false, the first
# listener starts playback and the station stops after the idle grace period.
continuous = false

# MP3 bitrate in kbps.  One of 128, 192, 256, 320.  The quality chosen on
# the Settings page is saved (web_state.json) and, like the other playback
# settings saved there, overrides this value and AUTODJ_STREAM_BITRATE on
# the next start.
bitrate = 320

# Seconds without a connected listener before the stream mix stops.
idle_grace_seconds = 30.0

# Maximum concurrent listener connections.
max_listeners = 8
# Limit simultaneous connections from one resolved address; 0 disables this limit.
max_listeners_per_address = 0
# Only these direct proxy peers may supply X-Forwarded-For and X-Forwarded-Proto.
# Empty trusts a proxy on this machine (127.0.0.1 and ::1), as when not streaming.
trusted_proxies = []
# Optional listener_user and listener_password belong in config.local.toml only.

# Station name announced to players via the icy-name header.
  station_name = "AutoDJ"

# More formats beside the MP3 stream, each at its own address and bitrate:
# AAC at /stream.aac (0 is off; 64, 96, 128, 192 or 256 kbps) and Opus at
# /stream.opus (0 is off; 48, 64, 96, 128 or 192 kbps).  Each one that is on
# runs its own ffmpeg encoder; max_listeners counts every format together.
# Settings, Stream, More formats changes them while the station plays.
aac_bitrate = 0
opus_bitrate = 0

# Days of listener statistics to keep (daily peaks, sessions and listening
# time per format; never addresses or player names).  0 keeps none.
stats_days = 90

# Relays: push the station to hosted Icecast or Shoutcast servers, so their
# listeners, directory listings and capacity carry it too.  One named table
# per server; the name is shown in Settings, Stream, in the log and in
# `autodj doctor`.  Relays run only in stream mode.  While any relay is
# enabled the station keeps playing with nobody connected to AutoDJ itself,
# as if `continuous` were true, because the relay's listeners are invisible
# here.  Each relay reconnects on its own when the server drops it, waiting
# 1 second, then 2, 4 and so on up to 60 seconds between tries.
#
# Keep the password out of this file: put it in config.local.toml under the
# same table name (see config.local.toml.example), or in the environment as
# AUTODJ_STREAM_RELAY_<NAME>_PASSWORD (the name upper-cased, "-" as "_").
# It is never saved to web_state.json, logged, or sent to the browser.
#
# [stream.relays.main]
# type = "icecast"            # "icecast" (2.4 or later), "shoutcast1" or "shoutcast2"
# host = "radio.example.com"  # host name or IP address only, no http:// or port
# port = 8000                 # the server's listener port (default 8000)
# mount = "/live"             # Icecast only: the mount point
# user = "source"             # Icecast only: the source user (default "source")
# stream_id = 1               # Shoutcast 2 only: the stream ID (default 1)
# bitrate = 128               # optional: 128, 192, 256 or 320; leave it out to send
#                             # the stream's own audio with no extra encoder
# public = false              # ask the server to list the station in directories
# enabled = true              # false keeps the settings but does not connect
#
# Shoutcast sources log in on the port above `port` (8001 for 8000), as
# Shoutcast expects; Shoutcast 2 is reached through its Shoutcast 1 source
# login with the stream ID.

# Archives of the exact MP3 sent to listeners. Recording needs stream mode.
# Set the folder here or in config.local.toml, never from the browser. Running
# state and the other settings can be changed in Settings, Stream and survive
# restarts.
[recording]
folder = "recordings"
split = "hour"          # "hour" or "show"
retention_days = 0      # 0 keeps files forever
free_space_mb = 100     # pause below this free-space floor

[playback]
# ReplayGain-only opening lift, returning to normal within 8 seconds (0 to 6; 0 disables).
intro_lift_max_db = 4.0
# Stereo Tool input gain before its output limiter, from -12 to +6 dB.
stereotool_input_trim_db = 0.0
# Stereo Tool Pre Compressor drive above the selected preset's base (0 to 12 dB).
# 0 keeps the preset's base drive; it does not turn AGC off.
stereotool_agc_drive_db = 7.0
# "included" or a .sts filename uploaded in Settings > Sound.
stereotool_preset = "included"
# Optional path of Thimeo's Stereo Tool plugin library (it named the old
# command-line program before).  Settings > Sound > Download Stereo Tool puts
# the library in <index_dir>/tools/stereo-tool/, which the default finds first:
# libStereoTool_intel64.so (64-bit Linux PC), libStereoTool_noX11_arm64.so
# (64-bit ARM Linux) or libStereoTool_64.dll (Windows).  Set this only to use
# another copy or build.
# stereotool_path = "/opt/stereo-tool/libStereoTool_intel64.so"
# Optional file holding this station's Stereo Tool licence key, for installs
# without a browser.  Normally the key is saved in Settings > Sound, or given
# for every station in AUTODJ_STEREOTOOL_LICENSE_KEY or
# AUTODJ_STEREOTOOL_LICENSE_FILE.  Never put the key itself here.
# stereotool_license_file = "/run/secrets/stereo-tool-license"
# Duration of the crossfade between tracks, in seconds, 0 to 20.  In the
# "full_intro_outro" and "outro_fade" modes below, a track with detected
# markers fades for 1 to 12 s instead, even at 0.  Otherwise 0 cuts from one
# track to the next, in the server mix and in the browser.
crossfade_seconds = 3.0

# Music speed change in percent (-10 to 10, up to two decimal places).
# Also saved per station from Settings > Sound > Music speed. Voice stays native.
music_speed_percent = 0.0

# Repeat rules are edited in Settings > Picking > Repeats and saved in
# index/<name>/web_state.json. Each artist, related artist, album, track, title and
# related track rule has a track count and a minute limit; 0 disables that limit.
# Both can be set.
# Older repeat keys are rejected. Remove them by hand and re-enter limits in
# Settings > Picking > Repeats. Optional starting values use the same structure:
# repeat_rules = { track = { tracks = 50, minutes = 0 }, artist = { tracks = 8, minutes = 0 }, related_artist = { tracks = 8, minutes = 0 }, album = { tracks = 0, minutes = 0 }, title = { tracks = 0, minutes = 0 }, related_track = { tracks = 20, minutes = 0 }, use_related_artists = false, use_related_tracks = false, versions_as_one_song = false, daypart = { days = 0, start_hours = [0, 6, 10, 15, 19] }, hourpart = { plays = 0 } }
# daypart.days (0 to 7) holds back a song that played in the same daypart today or on the days
# before; start_hours are where the dayparts start, in station hours. hourpart.plays (0 to 3)
# holds back a song from the quarter of the hour its last plays started in. 0 turns each off.
# Track counts other than the track rule's are capped at 5000. The related-artist file is
# fixed at index/<name>/related-artists.toml and the related-track file at
# index/<name>/related-tracks.toml; each is read only when enabled.
# AutoDJ copies the shipped sample only if that file does not exist.

# When false, AutoDJ loads no lyrics and the web UI hides the lyric card.
# Default true (lyrics shown).
show_lyrics = true

# Web-UI gapless prefetch — as soon as the server picks the next track,
# the browser's standby <audio> deck calls .load() so the bytes are
# buffered before the crossfade fires.  Eliminates the dead-air pause
# that happens when a slow disk / NAS still delivers the file.  Off
# only if you have very tight bandwidth budgets.
prefetch_next_track = true

# Silence-detector — the web UI's Web-Audio analyser samples the active
# deck once playback passes 95 % of the track's duration; if the RMS stays
# below −60 dBFS for 2 continuous seconds, it triggers the crossfade early so
# long fade-out tails don't leave a dead-air gap before the next track.
# The thresholds are deliberately late and long: an earlier, shorter trigger
# cut atmospheric tracks short on quiet mid-song passages.
silence_trigger_crossfade = true

# Optional — how often discovery plays a sonically distant track: every N
# tracks, 1 or more.  Discovery starts off; the Discovery button on the page turns it on
# and off, and setting the interval under Settings turns it on.
# discovery_every = 20

# Pro-DJ crossfade: applies a Butterworth high-pass sweep on the outgoing
# track during the overlap so its bass doesn't clash with the incoming
# track's bass.  Eliminates muddy "two-kicks-at-once" feel.  Tiny CPU cost.
# Server mix only (--server-audio, --stream); the browser ignores it.
crossfade_eq_duck = false
crossfade_bass_cutoff_hz = 180.0     # frequency below which outgoing track is attenuated

# Browser crossfades: how long the incoming track takes to reach full volume,
# in seconds, 0 to 20 and at most the crossfade length.  0 = it starts at
# full volume.
# The server mix ignores it.
fade_in_seconds = 3.0

# How the crossfade lines up with each track's intro / outro markers from
# the DJ-meta sidecar, as in Mixxx:
#   "full_intro_outro"   the fade starts at the outgoing outro_start and the
#                        incoming track enters at its first sound, so its
#                        intro plays under the outro; fade length =
#                        min(intro, outro), clamped to 1-12 s
#   "outro_fade"         fade begins at outro_start, lasts the outro (1-12 s)
#   "fixed_skip_silence" fixed crossfade_seconds at the track end; the
#                        incoming track enters at its first sound
#   "fixed"              plain fixed crossfade_seconds at the track end
transition_mode = "full_intro_outro"

# Where the picker seeds from once a user-built queue empties.
#   "last_queued"  continue from the final queued track (the user steered)
#   "pre_queue"    rewind to the track that was playing when the queue began
post_queue_seed = "last_queued"

# Weighted-random pick over the top K similarity candidates.  k = 1 is fully
# deterministic (same seed, same set).  For variety try k = 10 with
# temperature 0.3; higher temperature flattens the weighting.
pick_top_k = 1
pick_temperature = 0.3

# Optional hour fitting. During last 10 minutes before next top of hour,
# clockwheel restart or hard schedule event, prefer an eligible song whose
# end is closest to that time. Window accepts 1 to 30 minutes.
hour_fit = false
hour_fit_window_minutes = 10

# How the current key is shown: "camelot" (8A / 8B, matching the in-page
# wheel) or "musical" (C, Am, F#m).  Picker maths is unaffected.
key_notation = "camelot"
# Only read when key_notation = "musical": spell accidentals as flats.
key_prefer_flats = false

# Output device for server-side audio (`autodj serve --server-audio`).  Leave
# unset for the system default; otherwise a sounddevice index or a substring
# of the device name, as listed by `autodj list-devices`.
# audio_device = "Speakers"

# Merge cue points from Mixxx, Rekordbox (Library.xml export) and Traktor
# libraries, and from the Serato tags in each audio file, with the ones
# AutoDJ detects itself.  Read by `autodj index` and `autodj analyse` when
# they analyse a track, and by the player when it has to analyse a track
# while playing (`autodj serve` reads the three libraries once at startup,
# in the background); the web page has no switch for it.
# Intro and outro markers set in that software also move the mix: Mixxx's
# intro start and end and outro start, and Rekordbox's and Traktor's fade-in
# and fade-out points (read as intro start and outro start) replace the
# detected intro_start, intro_end and outro_start that transition_mode uses.
# A song analysed before this was added picks them up the first time it
# plays while `autodj serve` runs.
import_external_cues = true

# Beat-sync transition FX.  Browser crossfades: effect lengths round to
# whole bars at the outgoing tempo when its BPM and outro are known, and scratch, beat_repeat, sidechain_pump,
# transformer and stutter_build start on the next downbeat.  Server mix
# (stream mode, server audio): echo_out, dub_delay, gate_stutter,
# transformer, stutter_build, sidechain_pump, beat_repeat and scratch take
# their timing from the outgoing song's tempo, and the gates, loops and pump
# start on its next downbeat.  The server only trusts a tempo between 40 and
# 250 BPM whose beat tracking was confident (tempo_confidence 0.5 or more);
# otherwise the effects keep their fixed timings.
beat_sync_fx = true
# Key-sync pitched FX: air_horn, dub_siren and ring_modulator tune to the
# songs' root notes, in browser crossfades and in the server mix.
key_sync_fx = true

# Beatmatch when the user presses Skip: the browser pitch-preserves the new
# track onto the outgoing tempo instead of cold-cutting.  Server-side audio
# ignores it and uses skip_style below.
beatmatch_on_skip = false

# How Skip ends the playing track when the server mixes (--stream and
# --server-audio); browser playback keeps its own skip.
#   "fade"       quick 150 ms fade-out.  Default.
#   "echo_out"   the music cuts and its echoes ring out.
#   "backspin"   the record spins backwards to a stop.
#   "loop_roll"  a short loop repeats, rolling faster as it fades.
# The effects last one to two beats (at most 2 seconds) and end on a beat
# when the track's tempo is trusted; then the next track starts.
skip_style = "fade"

# Voice liners — short spoken clips layered over the mix.  Triggers are
# evaluated in the browser when it plays the audio, and on the server with
# --server-audio or --stream; any combination may be set, and a null /
# absent value disables that trigger.
liners_enabled = false
# liners_every_n_songs = 5             # after every N tracks
# liners_every_minutes = 20.0          # on a wall-clock timer
# liners_random_min_minutes = 10.0     # random window, lower bound
# liners_random_max_minutes = 25.0     # random window, upper bound
liners_pick_mode = "random"            # random | sequential
liners_duck_db = -12.0                 # how far the music ducks under a liner, -30 to 0 dB
# Talk-ups ("hitting the post"), server mix only: a liner due as a track
# starts is timed to end just before the incoming vocal (its first synced
# lyric line, else its detected intro end).  A liner too long for the intro
# starts during the crossfade when that fits; otherwise it plays as the
# track starts, as with this off.
liners_talk_up = false

# Longest track the server mixes with --server-audio or --stream, in
# minutes (1 to 600).  The server decodes each track whole, at about 21 MB
# per minute, and holds a few at once, so longer tracks (hour-long DJ mixes)
# are skipped with a log line.  Browser playback has no limit.
server_max_track_minutes = 15.0

# Spoken time checks. The time comes from a voice pack, then a recorded
# minute clip, then text to speech, whichever first has the minute.
# Voice packs are folders of RadioBOSS-style hour and minute files
# (hr_05.mp3 "it's 5", hr_05o.mp3 "it's 5 o'clock", m_56.mp3 "fifty-six",
# optional intro, outro, am and pm), joined with trimmed silence, matched
# loudness and a short crossfade; docs/operations.md lists the exact names.
# A pack's name in Settings is its folder name.  Clips use 24-hour minute
# names such as 03_05.wav, 15_05.mp3, or 00_00.flac; WAV, MP3, FLAC and OGG
# are accepted.  Missing minutes fall back to the external TTS command, if
# configured: an argument array (never a shell) that writes a WAV to {out},
# with the text on stdin or in {text}.  docs/operations.md has espeak-ng and
# Windows SAPI examples.
#
# Settings, Time checks manages the rest: every folder in the station's time
# checks folder (clips_folder below, or its default) is a voice pack with no
# line here, packs are added there from a zip and removed, and the recorded
# clips folder and the intro and outro clips are chosen there by name.  The
# values below are only the starting values until Settings saves its own.
# Only tts_command is set nowhere else, because it runs a program on the
# server.
[time_checks]
enabled = false
# The station's time checks folder: minute clips, intro and outro clips and
# one folder per voice pack.
# clips_folder = "~/.autodj/time_checks"  # default: <index_dir>/<name>/time_checks
hour_format = "12"                       # "12" or "24"
rule = "off"                             # "off" or "after_hour_song"
# Used until Settings chooses an intro or outro clip (or None).
# intro_clip = "~/.autodj/time-intro.wav"
# outro_clip = "~/.autodj/time-outro.wav"
# tts_command = ["piper", "--model", "/path/to/model.onnx", "--output_file", "{out}"]
# Packs kept outside the time checks folder; they are listed before the
# folders found there, and keep their name when a found folder has the same
# one.  Every pack is ticked until Settings saves a choice.
# voice_packs = ["~/Voices/Studio", "~/Voices/Night"]
pack_order = "rotate"                    # "rotate" (take turns) or "random"

# ---------------------------------------------------------------------------
# Announcer breaks: DJ breaks, news and weather from another program
# ---------------------------------------------------------------------------
# An announcer program on this machine can send this
# station spoken breaks through the breaks API, with a machine token made in
# Settings, Analysis workers (or `autodj tokens create NAME --scope announcer
# --station default`).  AutoDJ prepares each song change one song ahead, so a
# break joins the change after the next song.  Breaks need saved-point
# playback (transition mode "saved_points").  docs/operations.md, "Announcer
# breaks", has the API with example requests.
# enabled, dj_placement, min_intro_seconds and duck_db are used until you
# save Settings, Breaks for the station.  That tab changes them without a
# restart, and once it has saved them they win over these at every start (the
# log says so when they differ).  Saving other settings does not do that.  The
# limits below always stay here.
[breaks]
enabled = false
dj_placement = "auto"          # "auto": talk up the next song's intro when it
                               # is at least min_intro_seconds long, otherwise
                               # play between the songs; "talk_up"; "standalone"
min_intro_seconds = 2.0
# duck_db = -6.0               # music level under the voice; unset uses
                               # [playback] liners_duck_db
max_upload_mb = 40             # largest break file (at most 200)
max_seconds = 300.0            # longest break (at most 900); decoding takes
                               # about 0.35 MB of memory per second of it
max_queued = 6                 # breaks waiting to air at once
max_per_slot = 2               # breaks one song change can take
default_expires_seconds = 1800 # a break not on the air by then is dropped
max_expires_seconds = 7200
quota_mb = 400                 # disk space the waiting break files may use
requests_per_minute = 120      # per token

# ---------------------------------------------------------------------------
# Scheduled ad breaks
# ---------------------------------------------------------------------------
# Spots (advertiser, campaign, flight dates, daily and hourly caps) and ad
# breaks (minutes past the hour, or a Schedule event) are set up in the Ads
# tab.  A break airs between two songs at the next song change it can join,
# and every spot that aired or was missed is logged for the Ads report.
# Like [breaks], ads need saved-point playback with the server mixing the
# audio.  docs/operations.md, "Ad breaks", has the details.
[ads]
enabled = false
max_upload_mb = 20             # largest spot file (at most 200)
max_spot_seconds = 120.0       # longest spot (5 to 600)
max_spots = 200                # spots one station keeps (at most 1000)

# ---------------------------------------------------------------------------
# ReplayGain loudness normalisation
# ---------------------------------------------------------------------------
[replaygain]
# When true, AutoDJ reads embedded ReplayGain track-gain + peak tags
# (FLAC, MP3, M4A) and applies a clip-safe linear gain so all tracks play
# at consistent loudness.  Tracks without tags play unchanged.  Server mix
# only (--server-audio, --stream); the browser plays files as they are.
enabled = false

# Output reference loudness in dB.  -18 = original ReplayGain reference
# (quiet).  -14 ≈ Spotify / YouTube.  Higher = louder overall.
target_db = -14.0

# Caps the gain so a track's tagged peak times the gain stays at or below this
# fraction of full scale.
# 1.0 = no clipping, 0.95 = small headroom.
max_clip_safe_gain = 1.0

# ---------------------------------------------------------------------------
# Pro-DJ mixing layer (beatmatch, harmonic, phrase-align, outro/intro,
# filter sweep).  Every option is opt-in.  harmonic_mode steers the picker
# in every mode, and phrase_align / phrase_bars shape browser crossfades as
# well as the server mix; the other options shape the server mix only
# (--server-audio, --stream), and the browser ignores them.  Track
# analysis (intro/outro times + beat grid) comes from `autodj index` /
# `autodj analyse`, or is done on first play, and is cached in
# <index_dir>/<name>/dj_meta.db.
# ---------------------------------------------------------------------------
[djmix]
# Restrict next-track candidates to harmonically-compatible keys.  Tracks
# with unknown key always pass.  Reuses key/mode already in the index.
# `harmonic_mode` turns the filter on and selects how strict it is:
#   "off"          no harmonic filter.  Default.
#   "compatible"   classic Camelot rule (same pos, ±1 around wheel, or
#                  relative major/minor) — broadest pool.
#   "strict"       only the exact same Camelot position.
#   "neighbour"    same side of the wheel, ±1 only (no mode flips).
#   "mood_change"  relative major/minor only (same number, opposite side).
#   "energy_boost" same side, two steps up the wheel — set lifts over time.
harmonic_mode = "off"

# Time-stretch the incoming track (pitch preserved) so its BPM matches the
# outgoing track during the crossfade, then ease it back to its own tempo.
# When both tracks have a confident tempo and an analysed beat grid, the
# crossfade start also moves (by under a bar, or onto a phrase boundary with
# phrase_align) so the two tracks' downbeats land together.  Half and double
# time count as the same tempo (70 BPM mixes with 140).  Refuses to stretch
# beyond ±beatmatch_max_stretch.
beatmatch = false
beatmatch_max_stretch = 0.08      # ±8% — typical DJ practice
# Bars of the incoming track over which it glides back to its own tempo
# after the crossfade (at most 30 seconds); 0 returns it at once.
beatmatch_glide_bars = 8

# Drop-to-drop mixing (needs beatmatch).  When both tracks have a reliable
# drop, the incoming build-up plays under the outgoing track and the
# incoming drop lands on the downbeat that starts the outgoing track's next
# section (whole phrase_bars phrases after its drop or breakdown), where the
# crossfade ends.  With the "auto" transition effect a noise riser builds up
# to it.  Drops set in DJ software (a drop cue, or a hot cue named "Drop")
# come first; a detected drop counts only when it is unmistakable.  Pairs
# that do not fit (incoming drop more than 90 s in, outgoing track cut more
# than 32 s short, beat grids not trusted) mix as usual.
drop_mix = false

# Harmonic key shift.  When the incoming key clashes with the outgoing one
# but would mix one or two semitones higher or lower, the incoming track
# plays that much higher or lower (same tempo) during the crossfade, then
# slides back to its own key over beatmatch_glide_bars bars (at least 4 s).
key_shift = false

# Auto-detect each track's outro start and start the crossfade there, with
# the incoming track entering at its first sound.
outro_intro_align = false

# Snap the crossfade start time to the nearest phrase_bars-bar phrase
# boundary using the cached beat grid.  Pro-feel transitions on rhythmic music.
# Applies to the server mix and to crossfades played in the browser; a track
# with no detected beat grid crossfades at its usual point.
phrase_align = false
phrase_bars  = 8

# Apply a low-pass sweep on the outgoing tail (cutoff slides from
# full-range down to filter_sweep_floor_hz) — adds the classic
# filter-out energy lift that DJs use to launch into a build.
filter_sweep = false
filter_sweep_floor_hz = 250.0

# Vocal-clash guard, on by default: when both tracks have synced (LRC)
# lyrics, shorten or move the crossfade so the outgoing track's last sung
# line ends before the incoming track starts singing.  The fade is never
# lengthened or made shorter than 1 second; when nothing avoids the clash
# it stays as it was.  Server mix only.
vocal_guard = true

# ---------------------------------------------------------------------------
# Transition effects layered on every crossfade
# ---------------------------------------------------------------------------
# Each crossfade gets a chosen transition treatment on top of the
# standard amplitude fade.  Options:
#
#   "none"            standard crossfade only (default)
#   "echo_out"        feedback-delay echo tail on outgoing track
#   "reverb_tail"     Schroeder reverb on outgoing
#   "highpass_sweep"  high-pass sweep DOWN on incoming (filter-in)
#   "tape_stop"       vinyl-stop ramp-to-zero on outgoing
#   "gate_stutter"    rhythmic amplitude gate on outgoing
#   "noise_riser"     synthesised white-noise build layered on top
#   "backspin"        reversed-pitch sweep on outgoing (vinyl backspin)
#   "cross_eq_swap"   outgoing keeps highs / incoming brings bass
#   "random"          pick uniformly at random per crossfade
#   "rotate"          cycle through all real effects in order
#   "auto"            pick one to suit each pair of songs: backspin, dub
#                     siren or vinyl rewind into a discovery pick; echo out,
#                     tape stop, reverb tail, backspin or a low-pass sweep to
#                     hide tempos more than 8 % apart or clashing keys; noise
#                     riser or stutter build into a song at least 30 % louder;
#                     cross-EQ swap, high-pass sweep or a plain fade between
#                     songs in the same key within 3 % in tempo; otherwise a
#                     filter sweep, cross-EQ swap or echo out.
#
# That list is a sample.  The Settings tab's Transition effect dropdown
# offers every accepted name.
#
# wet_mix is the outer wet/dry between dry overlap and effect-processed
# overlap.  1.0 = full effect; 0.5 = subtle; 0.0 = effect inaudible.
[transitions]
effect  = "none"
wet_mix = 1.0

[model]
# HuggingFace model ID for the music embedding model.
# MuQ-large-msd-iter: 24 kHz, 1024-dim, ~300 M params, fp32 inference.
name = "OpenMuQ/MuQ-large-msd-iter"

# HuggingFace revision (branch, tag, or commit) to download and cache.
revision = "main"

# Uncomment to skip auto-download and point directly to a local model directory.
# manual_path = "models/MuQ-large-msd-iter"

[huggingface]
# Optional — but strongly recommended.
# Without a token, downloads are rate-limited and slower.
# Get a free token at https://huggingface.co/settings/tokens (read-only is fine)
# token = "hf_..."

# ---------------------------------------------------------------------------
# Optional: user-defined BPM presets
# ---------------------------------------------------------------------------
# Add named BPM-shaping presets that bias the next-song picker toward a
# target tempo (constant, linear ramp, or sine arch). Pick one under Settings in the
# web page.
# Each preset is a [presets.NAME] table.  Keys: bpm_target, bpm_start, bpm_end,
# curve ("linear" or "slide"), bpm_weight, horizon_tracks, discovery_every.
# A preset with any other key is skipped with a warning.  A name that matches a
# built-in preset (wakeup, chill, party, workout and the others) replaces it.
#
# [presets.focus_deep]
# bpm_target = 85
# bpm_weight = 0.15
#
# [presets.festival]
# bpm_start = 90
# bpm_end   = 145
# horizon_tracks = 60
# bpm_weight = 0.35
# discovery_every = 10
#
# [presets.arch]
# bpm_start = 80
# bpm_end   = 140
# curve     = "slide"

[dmca]
# DMCA mode: keep to the US statutory webcasting licence's performance
# complement (album, artist and box-set limits in any three hours) in every
# pick mode, warn before queueing a song that breaks it, and never show the
# next song publicly. Read when the server starts. General information, not
# legal advice; see docs/operations.md, "DMCA mode".
enabled = false

# Public now-playing feed at /api/nowplaying.
[nowplaying]
# Show the upcoming song on the public feed. Off by default: some webcasting
# licences, such as the US statutory licence, forbid announcing songs in
# advance. Settings, Stream also changes it.
show_next = false
# Recent completed songs in the feed, from 0 to 20.
history_limit = 5

# Public listener request page at /requests: listeners search the library and
# request songs. Off by default; it answers 404 while it is off. See "Listener
# requests" in docs/operations.md.
# enabled and approval are used until you save them in the Listener requests
# card in Queue & Search.  The card changes them without a restart, and once it
# has saved them they win over these at every start (the log says so when they
# differ).  Saving other settings does not do that.  The four bridge settings
# are kept whenever the station's settings are saved.
[requests]
enabled = false
# "manual": each request waits for you in Queue & Search; "auto": a request
# that keeps the repeat rules (and DMCA limits) is queued at once.
approval = "manual"
# Requests one listener address may make per per_listener_minutes.
per_listener = 3
per_listener_minutes = 60
# Requests the station takes per day, from everyone (station time zone).
daily_limit = 50
# Requests that may wait for you at once.
max_pending = 20
# How far ahead in the queue a request may be placed, in minutes.
window_minutes = 30
# Artists, and folders (full paths or relative to registered music folders), listeners cannot request.
blocked_artists = []
blocked_folders = []
# An IPv6 listener's limits count over this network: 56 (a whole home network),
# 64, or 128 for single addresses.
ipv6_prefix = 56
# Public player page at /player, where listeners press Play to hear the stream
# in the browser, and a compact version at /embed for other websites. Both off
# by default; each answers 404 while it is off. See "Player page and embeddable
# player" in docs/operations.md.
[player_page]
enabled = false
embed = false
# Sites that may show /embed in a frame, such as "https://nightowlradio.example",
# or "*" for any site. Empty: only this server's own pages.
embed_origins = []

# Webhook destinations belong ONLY in config.local.toml because URLs can hold
# tokens. Example for that file:
# [[webhooks]]
# url = "https://example.com/your-secret-endpoint"
# format = "generic" # or "discord"
# events = ["track_change"]

# ---------------------------------------------------------------------------
# More stations on one server
# ---------------------------------------------------------------------------
# The sections above are the default station.  Each [stations.<slug>] table
# adds another station that plays from the same library, with its own player,
# stream, recordings, schedule, carts, clockwheels and saved settings under
# <index_dir>/<name>/stations/<slug>/.  The slug uses lower-case letters,
# digits and inner hyphens (at most 32 characters); "default" is reserved.
# At most 8 such stations.  See "Several stations" in docs/operations.md.
#
# A station starts from the defaults, not from the sections above: set
# everything it needs here.  Its sections are playback, djmix, transitions,
# replaygain, stream, recording, nowplaying, player_page, requests, time_checks,
# breaks, dmca
# and presets.*;
# library, index, model, huggingface and server are shared and read only from
# the root.  Another station always streams (stream.enabled is ignored), and
# stream.trusted_proxies comes from the root [stream] section.  Its recording
# folder and relay targets must differ from every other station's.  Listener
# credentials, relay passwords and webhooks belong in config.local.toml under
# the same table names; a relay password can also come from
# AUTODJ_STATION_<SLUG>_RELAY_<NAME>_PASSWORD ("-" as "_").
#
# [stations.nightowl]
# autostart = true              # false: configured, stopped until started
#
# [stations.nightowl.stream]
# station_name = "Night Owl Radio"
# bitrate = 192
# continuous = true
# max_listeners = 20
#
# [stations.nightowl.playback]
# loudness_processing = "smooth"  # one Stereo Tool licence: one station uses it
#
# [stations.nightowl.recording]
# folder = "recordings/nightowl"
